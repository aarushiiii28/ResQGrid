# ResQGrid demo configuration. No API keys are required.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/resqgrid
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/resqgrid_test
JWT_SECRET=demo-only-secret-change-me-0123456789abcdef
CITY_LAT=30.9010
CITY_LNG=75.8573
SEED=42
ROUTING_PROVIDER=mock          # mock | osrm
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT_S=3
DEMO_AUTOPILOT=true
DEMO_AUTOPILOT_DELAY_S=3
# Optional LLM extraction (off by default; typed/mock extraction is used otherwise)
LLM_EXTRACTION=false
ANTHROPIC_API_KEY=

